  Sentence:
  - ActorData: {fileID: 11400000, guid: 3d61bfc576f3916488e993b9d8e5df7d, type: 2}
    Content: "\u201CKenji n\xE3o \xE9 fracote. Voc\xEAs n\xE3o precisam disso para
      se sentirem fortes"
    perguntasID: 
  - ActorData: {fileID: 11400000, guid: 606985207b443e946b45dc247483ac66, type: 2}
    Content: "Voc\xEA fala bonito, mas n\xE3o entende nada. A vida \xE9 dura, e fracos
      n\xE3o\r\nsobrevivem."
    perguntasID: RespostaPositiva
