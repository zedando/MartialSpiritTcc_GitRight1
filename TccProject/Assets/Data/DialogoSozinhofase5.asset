  m_Script: {fileID: 11500000, guid: fd68d3648d832c140802d19e8a58d91d, type: 3}
  m_Name: DialogoSozinhofase5
  m_EditorClassIdentifier: 
  Sentence:
  - ActorData: {fileID: 11400000, guid: 3d61bfc576f3916488e993b9d8e5df7d, type: 2}
    Content: "Mais um dia se inicia... Ainda consigo \nouvir as palavras do meu mestre\r
      \necoando na mente"
    perguntasID: 
  - ActorData: {fileID: 11400000, guid: 3d61bfc576f3916488e993b9d8e5df7d, type: 2}
    Content: "'Karate-Do n\xE3o \xE9 sobre vencer os outros, \nmas sobre vencer\r
      a si mesmo.'"
    perguntasID: 
  - ActorData: {fileID: 11400000, guid: 3d61bfc576f3916488e993b9d8e5df7d, type: 2}
    Content: "Hoje tenho treino cedo... \xC9 hora de ir \npara o Dojo. Quero mostrar\r
      que \nestou evoluindo, n\xE3o s\xF3 nos golpes,\n mas como pessoa."
    perguntasID: 
